# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# ---- AI provider (optional) -------------------------------------------
# With no key the copilot runs the deterministic engine over the same tools:
# still correct, just not conversational.
LLM_PROVIDER=gemini
LLM_MODEL=gemma-4-31b-it
GEMINI_API_KEY=

# For LLM_PROVIDER=openai
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# ---- Storage ------------------------------------------------------------
# Must NOT be the Postgres superuser: superusers bypass Row Level Security.
# ./start.sh creates this role automatically on first run.
DATABASE_URL=postgresql://xray_app:xrayapp@localhost:5432/xray

# ---- Security ----------------------------------------------------------
# Change this for any real deployment.
JWT_SECRET=dev-secret-local-check

# ---- Ports -------------------------------------------------------------
API_PORT=8000
WEB_PORT=3000
